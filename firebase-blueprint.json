{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the SMM panel.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "balance": { "type": "number" },
        "spent": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Banned"] },
        "role": { "type": "string", "enum": ["User", "Reseller", "Admin"] },
        "joined": { "type": "string" }
      },
      "required": ["id", "username", "email", "balance", "spent", "status", "role", "joined"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    }
  }
}
